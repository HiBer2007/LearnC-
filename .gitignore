# ============================================================================
#  C/C++ 编译与调试教材 —— 版本控制忽略规则
# ============================================================================

# ---------------------------------------------------------------- 构建产物
# 可以随时删掉，按 F5 会自动重建
build/
out/
*.exe
*.dll
*.lib
*.exp

# ---------------------------------------------------------------- 中间文件
*.o
*.obj
*.pdb
*.ilk
*.idb
*.pch
*.gch
*.d
*.map
*.hex
*.bin
*.elf
*.lst
*.su

# ---------------------------------------------------------------- CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
build.ninja
*.ninja

# ---------------------------------------------------------------- 调试产物
# 动态内存没释放但进程退出时产生的转储文件
*.dmp
core
vgcore.*

# ---------------------------------------------------------------- 编辑器与 IDE
.vs/
.vscode/ipch/
*.user
*.suo
*.VC.db
*.VC.opendb
.cache/
.clangd/

# ---------------------------------------------------------------- 提权通道
# 这是本机搭建环境时用的辅助工具，不属于教材内容。
# 其中「请求」「结果」两个目录是运行期数据，不入库。
工具/提权通道/
工具/**/结果/

# ---------------------------------------------------------------- 生成的安装介质
# 云镜像转换产物与 cloud-init 种子盘（体积大，可由脚本重新生成）
工具/云镜像虚拟机/seed.iso
*.vhdx

# ---------------------------------------------------------------- 大体积素材
# 视频文件超过 GitHub 的单文件上限（100 MB），由网盘等其他渠道分发
*.mkv
*.mp4
*.avi
*.iso

# ---------------------------------------------------------------- 练习副本
# 这份是读者自己的练习目录，不属于教材
空模板 - 副本/
C-空模板 - 副本/

# ---------------------------------------------------------------- 本地文件
# 编写教材时用的约定与工程笔记，面向本地 AI，不对外发布
AGENTS.local.md
*.local.md

# ---------------------------------------------------------------- 系统文件
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/

# ---------------------------------------------------------------- 临时文件
*.tmp
*.temp
*.log
~$*
*.bak
*.orig
*.rej

# 待拆分重建的文档（本地保留，不上传）
临时/
