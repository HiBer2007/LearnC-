{
  // ===================================================================
  //  示例 08 · 导出器系统（抽象基类 + 工厂 + 虚析构）—— 调试配置
  //
  //  四个配置 = 两个目标 × 两条调试路线：
  //    app_cli  命令行版，控制台里看三种格式的渲染结果
  //    app_gui_win32  GUI 版（Win32 API），窗口里点面板切换格式
  //
  //  ── 关于「GDB ·」开头的配置（重要） ──
  //    所在路径含中文时，GDB 无法启动调试，且无法通过配置项解决：
  //      GDB 经 MI 协议接收文件名时期望 ANSI 代码页(936)字节，
  //      而 VS Code 发送 UTF-8 字节，两者不一致，GDB 打不开可执行文件。
  //
  //    表现：提示 "Program path ... is missing or invalid"（但文件确实存在），
  //          或弹出空的「选择要终止的调试会话」列表后无反应。
  //
  //    工程所在路径含中文时，「GDB ·」配置【不可用】，
  //    请使用「MSVC ·」配置（或用 CodeLLDB）。
  //    把工程移到全英文路径后，GDB 配置即可恢复正常。
  //
  //    详见《01-编译器/02-环境配置.md》第 1 章第 2 节、第 9 章第 13 节。
  // ===================================================================
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDB · 命令行版 (MinGW g++)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw/bin/app_cli.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "构建: CMake (MinGW + GDB)",
      "setupCommands": [
        {
          // GDB 里看 std::vector / std::string 的整齐打印，
          // 靠的是下面三条命令，缺一不可（原因见示例 02 的 README）。
          "description": "把 libstdc++ 的 pretty-printer 脚本目录加进 GDB 的 Python 路径",
          "text": "python import sys, glob, os, gdb; sys.path += glob.glob(os.path.join(os.path.dirname(os.path.dirname(gdb.PYTHONDIR)), 'gcc-*', 'python'))",
          "ignoreFailures": true
        },
        {
          "description": "注册 libstdc++ pretty-printer（真正让它生效的一步）",
          "text": "python import libstdcxx.v6",
          "ignoreFailures": true
        },
        {
          "description": "为 MI 输出启用整齐打印（VS Code 走的就是 MI 协议）",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "关闭分页",
          "text": "set pagination off",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "programOutput": true
      }
    },
    {
      "name": "MSVC · 命令行版 (MSVC cl)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc/bin/Debug/app_cli.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "构建: CMake (MSVC)"
    },
    {
      // GUI 版没有控制台窗口。停在工厂或 render 的断点上，
      // 能看到 this 实际指向 CsvExporter、MarkdownExporter 还是 JsonExporter。
      "name": "GDB · GUI 版 Win32 (MinGW g++)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw/bin/app_gui_win32.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "构建: CMake (MinGW + GDB)",
      "setupCommands": [
        {
          "description": "关闭分页",
          "text": "set pagination off",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "programOutput": true
      }
    },
    {
      "name": "MSVC · GUI 版 Win32 (MSVC cl)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc/bin/Debug/app_gui_win32.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "构建: CMake (MSVC)"
    }
  ]
}
