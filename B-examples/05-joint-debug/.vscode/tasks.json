{
  // ===================================================================
  //  示例 05 · 联合调试 —— 构建任务
  //
  //  这个工程同时包含两个程序：
  //    server.c   运行在 Linux（WSL 或虚拟机）中
  //    client.c   运行在 Windows 中
  //
  //  因此构建也分两边。两者互相独立，可以分别触发。
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    // ---------------------------------------------------------------
    //  服务端：在 WSL 的 Ubuntu 中用 gcc 编译
    //
    //  注意路径换算：Windows 的 K:\ 在 WSL 中对应 /mnt/k/
    //  调试配置里的 program 必须写 Linux 侧路径，编译产物自然也要放在
    //  能被 Linux 看到的位置——也就是这个 /mnt/ 下的目录。
    // ---------------------------------------------------------------
    {
      "label": "构建: 服务端 (WSL · gcc)",
      "type": "process",
      "command": "wsl.exe",
      "args": [
        "-d", "Ubuntu", "--",
        "bash", "-lc",
        "cd '/mnt/k/C相关课程/B-examples/05-joint-debug' && gcc -g -O0 -Wall -Wextra server.c -o server && echo '服务端构建完成'"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },

    // ---------------------------------------------------------------
    //  客户端：在 Windows 中用 MinGW gcc 编译
    //
    //  -lws2_32 是 Windows 套接字库，必须在命令行末尾。
    //  输出用反斜杠：路径含中文时正斜杠会让 ld.exe 报
    //  "cannot open output file"（见《01-编译器/02-环境配置.md》第 9 章第 5 节）。
    // ---------------------------------------------------------------
    {
      "label": "构建: 客户端 (Windows · gcc)",
      "type": "process",
      "command": "gcc",
      "args": [
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-finput-charset=UTF-8",
        "-fexec-charset=GBK",
        "${workspaceFolder}\\client.c",
        "-o",
        "${workspaceFolder}\\build\\client.exe",
        "-lws2_32"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },

    // ---------------------------------------------------------------
    //  一次性构建两边，供联合调试的 preLaunchTask 使用
    // ---------------------------------------------------------------
    {
      "label": "构建: 联合调试 (两端)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "准备: 创建输出目录",
        "构建: 服务端 (WSL · gcc)",
        "构建: 客户端 (Windows · gcc)"
      ],
      "problemMatcher": [],
      "detail": "依次编译 Linux 服务端与 Windows 客户端"
    },

    {
      "label": "准备: 创建输出目录",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "[System.IO.Directory]::CreateDirectory('${workspaceFolder}\\build') | Out-Null"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "close": true }
    }
  ]
}
