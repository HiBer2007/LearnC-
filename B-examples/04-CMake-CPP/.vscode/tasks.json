{
  // ===================================================================
  //  示例 04 · CMake 工程（C++）—— 构建任务
  //  与示例 03 唯一的区别：MinGW 预设用 g++ 而不是 gcc
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 配置 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 编译 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "构建: CMake (MinGW + GDB)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MinGW + GDB)",
        "CMake: 编译 (MinGW + GDB)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/mingw/bin/app.exe"
    },

    {
      "label": "CMake: 配置 (MSVC + VS2022)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "msvc-vs2022"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 编译 (MSVC + VS2022)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "构建: CMake (MSVC + VS2022)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MSVC + VS2022)",
        "CMake: 编译 (MSVC + VS2022)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/msvc/bin/Debug/app.exe"
    }
  ]
}
