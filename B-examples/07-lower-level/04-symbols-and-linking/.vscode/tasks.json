{
  // ===================================================================
  //  示例 07-lower-level/04-symbols-and-linking · 符号与链接
  //                                            —— 构建任务
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 配置 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "CMake: 编译 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "构建: CMake (MinGW + GDB)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MinGW + GDB)",
        "CMake: 编译 (MinGW + GDB)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/mingw/bin/app_cli.exe 与 app_cli_slim.exe"
    },

    {
      "label": "符号表: nm 看两个目标的差别",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-Command",
        "nm build/mingw/bin/app_cli.exe | Select-String 'll_'; Write-Output '--- slim ---'; nm build/mingw/bin/app_cli_slim.exe | Select-String 'll_'"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "对比两个 exe 里 ll_ 开头的符号：slim 版少了 link_static_b.o 那几个"
    },

    {
      "label": "CMake: 配置 (MSVC)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "msvc"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "CMake: 编译 (MSVC)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "构建: CMake (MSVC)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MSVC)",
        "CMake: 编译 (MSVC)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/msvc/bin/Debug/app_cli.exe"
    }
  ]
}
