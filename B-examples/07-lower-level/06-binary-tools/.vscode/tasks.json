{
  // ===================================================================
  //  示例 07-lower-level/06-binary-tools · 把工具的输出读成结论
  //                                          —— 构建任务
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: 配置 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "CMake: 编译 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "构建: CMake (MinGW + GDB)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MinGW + GDB)",
        "CMake: 编译 (MinGW + GDB)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/mingw/bin/app_cli.exe"
    },

    {
      "label": "裸工具: 直接跑 size / nm / objdump",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-Command",
        "size build/mingw/bin/app_cli.exe; Write-Output '--- nm（只看非局部符号）---'; nm --extern-only build/mingw/bin/app_cli.exe | Select-Object -First 20; Write-Output '--- objdump -h ---'; objdump -h build/mingw/bin/app_cli.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "与本示例打印出来的结论对照，看原始输出长什么样"
    },

    {
      "label": "CMake: 配置 (MSVC)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "msvc"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "CMake: 编译 (MSVC)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "构建: CMake (MSVC)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MSVC)",
        "CMake: 编译 (MSVC)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/msvc/bin/Debug/app_cli.exe"
    }
  ]
}
