{
  // ===================================================================
  //  示例 07-lower-level/06-binary-tools · 把工具的输出读成结论
  //                                          —— 调试配置
  //
  //  这个示例的观察对象是终端上的输出，单步意义不大；
  //  真要看解析过程，断点打在 bt_parse_* 三个函数里。
  //
  //  「GDB ·」配置在路径含中文时不可用（GDB 经 MI 收到的文件名是 ANSI 代码页
  //  字节，而 VS Code 发的是 UTF-8）；路径含中文时请用「MSVC ·」配置。
  // ===================================================================
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDB · app_cli (MinGW)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw/bin/app_cli.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "构建: CMake (MinGW + GDB)",
      "setupCommands": [
        { "description": "关闭分页", "text": "set pagination off", "ignoreFailures": true }
      ],
      "logging": { "moduleLoad": false, "programOutput": true }
    },
    {
      "name": "GDB · 只跑自测",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw/bin/app_cli.exe",
      "args": ["selftest"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "构建: CMake (MinGW + GDB)",
      "setupCommands": [
        { "description": "关闭分页", "text": "set pagination off", "ignoreFailures": true }
      ],
      "logging": { "moduleLoad": false, "programOutput": true }
    },
    {
      "name": "MSVC · app_cli (cl.exe)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc/bin/Debug/app_cli.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "构建: CMake (MSVC)"
    }
  ]
}
