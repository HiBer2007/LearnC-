{
  // ===================================================================
  //  示例 03 · CMake 工程（C）—— 调试配置
  //
  //  ── 关于「GDB ·」开头的配置（重要） ──
  //    所在路径含中文时，GDB 无法启动调试，且无法通过配置项解决：
  //      GDB 经 MI 协议接收文件名时期望 ANSI 代码页(936)字节，
  //      而 VS Code 发送 UTF-8 字节，两者不一致，GDB 打不开可执行文件。
  //
  //    表现：提示 "Program path ... is missing or invalid"（但文件确实存在），
  //          或弹出空的「选择要终止的调试会话」列表后无反应。
  //
  //    工程所在路径含中文时（此类路径下），「GDB ·」配置【不可用】，
  //    请使用「MSVC ·」配置（或用 CodeLLDB）。
  //    把工程移到全英文路径后，GDB 配置即可恢复正常。
  //
  //    详见《01-编译器/02-环境配置.md》第 1 章第 2 节、第 9 章第 13 节。
  //
  //  注意：两个 program 路径不一样，因为生成器不同：
  //     Ninja（单配置）        → build/mingw/bin/app.exe
  //     Visual Studio（多配置）→ build/msvc/bin/Debug/app.exe
  //     那层 Debug/ 是多配置生成器自动加的，写错就是「找不到 exe」
  // ===================================================================
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDB · CMake 工程 (MinGW gcc)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw/bin/app.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "构建: CMake (MinGW + GDB)",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "关闭分页",
          "text": "set pagination off",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "moduleLoad": false,
        "programOutput": true
      }
    },
    {
      "name": "MSVC · CMake 工程 (MSVC cl)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc/bin/Debug/app.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "构建: CMake (MSVC)"
    }
  ]
}
