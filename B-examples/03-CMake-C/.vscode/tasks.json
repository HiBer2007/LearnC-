{
  // ===================================================================
  //  示例 03 · CMake 工程（C）—— 构建任务
  //
  //  CMake 要分两步：先「配置」(configure) 再「编译」(build)。
  //  这里用 dependsOn + dependsOrder: sequence 把它们串成一个任务，
  //  这样 launch.json 里只需要引用一个名字。
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    // ===============================================================
    //  MinGW + GDB
    // ===============================================================
    {
      "label": "CMake: 配置 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "mingw-gdb"],
      // 直接调用 PATH 中的 cmake，不写死安装路径。
      // 若提示找不到 cmake，请先把它加入 PATH（见《配置指南-从零开始.md》第 3 章）。
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 编译 (MinGW + GDB)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "mingw-gdb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "构建: CMake (MinGW + GDB)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MinGW + GDB)",
        "CMake: 编译 (MinGW + GDB)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/mingw/bin/app.exe"
    },

    // ===============================================================
    //  MSVC + VS2022 调试器
    //  用 Visual Studio 生成器时【不需要】vcvars——CMake 自己会找到 VS
    // ===============================================================
    {
      "label": "CMake: 配置 (MSVC + VS2022)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "msvc-vs2022"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "CMake: 编译 (MSVC + VS2022)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "msvc-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "构建: CMake (MSVC + VS2022)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CMake: 配置 (MSVC + VS2022)",
        "CMake: 编译 (MSVC + VS2022)"
      ],
      "problemMatcher": [],
      "detail": "配置并编译，产物 build/msvc/bin/Debug/app.exe"
    }
  ]
}
