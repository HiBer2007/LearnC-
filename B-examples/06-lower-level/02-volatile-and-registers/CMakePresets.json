{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-gdb",
      "displayName": "MinGW GCC + GDB (Ninja, Debug)",
      "description": "不优化：两种等待写法看不出差别，这一档用来对照 -O0 的行为",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW GCC (Ninja, Release, -O2)",
      "description": "开优化：不带 volatile 的那一份会失效，本示例的结论就出在这一档",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Visual Studio 17 2022, x64)",
      "description": "cl.exe 编译，产物 build/msvc/bin/Debug/app_cli.exe",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-gdb",
      "displayName": "编译 (MinGW, Debug)",
      "configurePreset": "mingw-gdb"
    },
    {
      "name": "mingw-release",
      "displayName": "编译 (MinGW, -O2)",
      "configurePreset": "mingw-release"
    },
    {
      "name": "msvc-debug",
      "displayName": "编译 (MSVC, Debug)",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "编译 (MSVC, Release)",
      "configurePreset": "msvc",
      "configuration": "Release"
    }
  ]
}
