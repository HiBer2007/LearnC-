{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-gdb",
      "displayName": "MinGW G++ + GDB (Ninja, Debug)",
      "description": "g++ 编译，产出 DWARF 调试信息，供 GDB 调试；产物 build/mingw/bin/app_cli.exe",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW G++ (Ninja, Release, -O2)",
      "description": "同一份源码用 -O2 编译，用来看优化后的布局与伪共享差别",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC + Visual Studio 调试器 (Visual Studio 17 2022, x64)",
      "description": "cl.exe 编译，产出 PDB，供 Visual Studio 调试器调试；产物 build/msvc/bin/Debug/app_cli.exe",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-gdb",
      "displayName": "编译 (MinGW + GDB)",
      "configurePreset": "mingw-gdb"
    },
    {
      "name": "mingw-release",
      "displayName": "编译 (MinGW, -O2)",
      "configurePreset": "mingw-release"
    },
    {
      "name": "msvc-debug",
      "displayName": "编译 (MSVC, Debug)",
      "configurePreset": "msvc",
      "configuration": "Debug"
    }
  ]
}
