{
  // ===================================================================
  //  工作区级构建任务 —— 只管「单文件」
  //
  //  这些任务被 .vscode/launch.json 里的 preLaunchTask 引用，
  //  两边的名字必须【字字相同】。改一个就要改另一个。
  //
  //  CMake 工程的构建任务在各自的示例文件夹里，不在这个文件。
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    // ---------------------------------------------------------------
    //  准备：建输出目录
    //  gcc 不会自己建目录，缺了会报：
    //    ld.exe: cannot open output file ...: No such file or directory
    //
    //  这里用 PowerShell 的 .NET 方法建目录，原因：
    //    1. 不依赖 cmake —— 只做单文件调试的人不必安装 CMake
    //    2. 幂等 —— 目录已存在时同样成功
    //    3. 参数是单个字符串，不涉及引号转义问题
    //
    //  这里刻意【不用】cmd /c "if not exist ... mkdir ..."：
    //     VS Code 的 process 任务按 MSVCRT 规则给参数加引号（内部 " 转义成 \"），
    //     而 cmd.exe 不认 \" 转义，会报
    //       "The filename, directory name, or volume label syntax is incorrect."
    //     任务直接失败。
    // ---------------------------------------------------------------
    {
      "label": "准备: 创建输出目录",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "[System.IO.Directory]::CreateDirectory('${workspaceFolder}\\build\\single\\gcc') | Out-Null"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    },

    // ---------------------------------------------------------------
    //  C 单文件 · gcc
    //
    //  -finput-charset=UTF-8  源码按 UTF-8 读取
    //  -fexec-charset=GBK     字符串常量按 GBK 写入 exe，匹配中文 Windows
    //                         的 CP936 控制台。缺少这两项时 gcc 把字符串
    //                         写成 UTF-8，中文控制台按 GBK 解读即乱码。
    // ---------------------------------------------------------------
    {
      "label": "构建: C 单文件 (gcc + GDB)",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=gnu17",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-finput-charset=UTF-8",
        "-fexec-charset=GBK",
        "${file}",
        "-o",
        "${workspaceFolder}\\build\\single\\gcc\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": ["准备: 创建输出目录"],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "detail": "用 gcc 编译当前 .c 文件（-g 生成 DWARF 调试信息，供 GDB 使用）"
    },

    // ---------------------------------------------------------------
    //  C++ 单文件 · g++
    //  必须用 g++：gcc 编译 .cpp 不会链接 libstdc++，
    //  会报一堆 undefined reference to `std::cout' 之类
    //
    //  字符集参数同上（见 C 单文件任务的说明）
    // ---------------------------------------------------------------
    {
      "label": "构建: C++ 单文件 (g++ + GDB)",
      "type": "process",
      "command": "g++",
      "args": [
        "-std=gnu++17",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-finput-charset=UTF-8",
        "-fexec-charset=GBK",
        "${file}",
        "-o",
        "${workspaceFolder}\\build\\single\\gcc\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": ["准备: 创建输出目录"],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "detail": "用 g++ 编译当前 .cpp 文件（C++ 必须用 g++，不能用 gcc）"
    },

    // ---------------------------------------------------------------
    //  单文件 · MSVC cl
    //  cl.exe 按扩展名自动判断 C / C++，所以 C 和 C++ 共用一个任务。
    //  编译逻辑在 tools/build-msvc.ps1 里（要先加载 vcvars 环境）。
    // ---------------------------------------------------------------
    {
      "label": "构建: 单文件 (MSVC cl)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\tools\\build-msvc.ps1",
        "-Source",
        "${file}",
        "-Output",
        "${workspaceFolder}\\build\\single\\msvc\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "detail": "用 cl.exe 编译当前文件（C 或 C++ 都行），生成带 PDB 的 exe，供 Visual Studio 调试器使用"
    }
  ]
}
